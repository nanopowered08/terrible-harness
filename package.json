{
  "name": "askgpt",
  "version": "1.0.0",
  "description": "Terminal chat assistant connecting to any LLM API with context, thinking (Ctrl+T), and tool calling",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "askgpt": "./bin/askgpt.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node bin/askgpt.js"
  },
  "keywords": [
    "llm",
    "cli",
    "ai",
    "terminal",
    "repl",
    "gpt",
    "groq",
    "anthropic",
    "llama"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.72",
    "@ai-sdk/groq": "^4.0.55",
    "@ai-sdk/openai": "^4.0.84",
    "@inquirer/prompts": "^8.7.3",
    "ai": "^7.0.128",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "dotenv": "^18.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
